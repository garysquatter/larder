{%- comment -%}
  Inline stroke icons. Usage: {% render 'icon', name: 'cart' %}
{%- endcomment -%}
{%- capture attrs -%}class="icon icon-{{ name }}{% if class %} {{ class }}{% endif %}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ stroke | default: 2 }}" stroke-linecap="round" stroke-linejoin="round"{%- endcapture -%}
{%- case name -%}
  {%- when 'search' -%}<svg {{ attrs }}><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
  {%- when 'account' -%}<svg {{ attrs }}><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/></svg>
  {%- when 'cart' -%}<svg {{ attrs }}><path d="M5 7h14l-1.5 13h-11z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>
  {%- when 'menu' -%}<svg {{ attrs }}><path d="M4 7h16M4 12h16M4 17h16"/></svg>
  {%- when 'close' -%}<svg {{ attrs }}><path d="M6 6l12 12M18 6 6 18"/></svg>
  {%- when 'check' -%}<svg {{ attrs }}><path d="m5 12 5 5 9-10"/></svg>
  {%- when 'check-circle' -%}<svg {{ attrs }}><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg>
  {%- when 'arrow' -%}<svg {{ attrs }}><path d="M5 12h14M13 6l6 6-6 6"/></svg>
  {%- when 'plus' -%}<svg {{ attrs }}><path d="M12 5v14M5 12h14"/></svg>
  {%- when 'minus' -%}<svg {{ attrs }}><path d="M5 12h14"/></svg>
  {%- when 'eye' -%}<svg {{ attrs }}><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
  {%- when 'filter' -%}<svg {{ attrs }}><path d="M4 7h10M18 7h2M4 17h4M12 17h8"/><circle cx="16" cy="7" r="2"/><circle cx="10" cy="17" r="2"/></svg>
  {%- when 'clock' -%}<svg {{ attrs }}><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
  {%- when 'pin' -%}<svg {{ attrs }}><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
  {%- when 'bag' -%}<svg {{ attrs }}><path d="M6 8h12l-1 12H7z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
  {%- when 'chevron' -%}<svg {{ attrs }}><path d="m6 9 6 6 6-6"/></svg>
  {%- when 'leaf' -%}<svg {{ attrs }}><path d="M5 19c0-9 6-14 15-14 0 9-5 15-14 15"/><path d="M5 19 13 11"/></svg>
  {%- when 'flame' -%}<svg {{ attrs }}><path d="M12 3c1 4 5 5.5 5 10a5 5 0 0 1-10 0c0-2.5 1.5-3.5 2-5 1 1 1.5 2 1.5 3 1.5-1.5 2-4.5 1.5-8z"/></svg>
  {%- when 'truck' -%}<svg {{ attrs }}><path d="M3 6h11v10H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg>
  {%- when 'heart' -%}<svg {{ attrs }}><path d="M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.5-7 10-7 10z"/></svg>
  {%- when 'wheat' -%}<svg {{ attrs }}><path d="M12 21V8M12 8c-2-1-3-3-3-5 2 0 3 2 3 5zm0 0c2-1 3-3 3-5-2 0-3 2-3 5zM12 13c-2-1-3.5-3-3.5-5 2 .5 3.5 2.5 3.5 5zm0 0c2-1 3.5-3 3.5-5-2 .5-3.5 2.5-3.5 5zM12 18c-2-1-3.5-3-3.5-5 2 .5 3.5 2.5 3.5 5zm0 0c2-1 3.5-3 3.5-5-2 .5-3.5 2.5-3.5 5z"/></svg>
  {%- when 'instagram' -%}<svg {{ attrs }}><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".6" fill="currentColor"/></svg>
  {%- when 'facebook' -%}<svg {{ attrs }}><path d="M15 3h-2.5A3.5 3.5 0 0 0 9 6.5V10H6v3.5h3V21h3.5v-7.5h3L16 10h-3.5V7a1 1 0 0 1 1-1H16z"/></svg>
  {%- when 'tiktok' -%}<svg {{ attrs }}><path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.5 2.5 2.5 4.5 5 4.5"/></svg>
  {%- when 'x' -%}<svg {{ attrs }}><path d="M4 4l16 16M20 4 4 20"/></svg>
  {%- when 'youtube' -%}<svg {{ attrs }}><rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="m10 9.5 5 2.5-5 2.5z"/></svg>
  {%- when 'pinterest' -%}<svg {{ attrs }}><circle cx="12" cy="12" r="9"/><path d="M11 8.5c3-1 5 .5 5 3s-2 4-3.5 3.5M12 11l-2 9"/></svg>
{%- endcase -%}
