      {
        "type": "select",
        "id": "style_preset",
        "label": "t:settings_schema.style.settings.style_preset.label",
        "info": "t:settings_schema.style.settings.style_preset.info",
        "options": [
          {
            "value": "street",
            "label": "t:settings_schema.style.settings.style_preset.options__1.label"
          },
          {
            "value": "artisan",
            "label": "t:settings_schema.style.settings.style_preset.options__2.label"
          },
          {
            "value": "fresh",
            "label": "t:settings_schema.style.settings.style_preset.options__3.label"
          },
          {
            "value": "custom",
            "label": "t:settings_schema.style.settings.style_preset.options__4.label"
          }
