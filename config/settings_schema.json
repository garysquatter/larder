      {
        "type": "select",
        "id": "feature_image_shape",
        "label": "t:settings_schema.style.settings.feature_image_shape.label",
        "options": [
          {
            "value": "default",
            "label": "t:settings_schema.style.settings.feature_image_shape.options__1.label"
          },
          {
            "value": "arch",
            "label": "t:settings_schema.style.settings.feature_image_shape.options__2.label"
          }
        ],
        "default": "default"
      },
      {
        "type": "select",
        "id": "category_style",
        "label": "t:settings_schema.style.settings.category_style.label",
