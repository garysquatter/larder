      {
        "type": "header",
        "content": "Product cards"
      },
      {
        "type": "checkbox",
        "id": "quick_view",
        "label": "Show quick view button",
        "info": "An eye button on product images opens images, details and add to cart in a pop-up.",
        "default": true
      }
    ]
  },
