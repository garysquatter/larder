  {
    "name": "t:settings_schema.typography.name",
    "settings": [
      {
        "type": "header",
        "content": "t:settings_schema.typography.settings.header__1.content"
      },
      {
        "type": "select",
        "id": "heading_font",
        "label": "t:settings_schema.typography.settings.heading_font.label",
        "options": [
          {
            "value": "bebas",
            "label": "Bebas Neue"
          },
          {
            "value": "fraunces",
            "label": "Fraunces"
          },
          {
            "value": "bricolage",
            "label": "Bricolage Grotesque"
          },
          {
            "value": "library",
            "label": "t:settings_schema.typography.settings.font_library_option"
          }
        ],
        "default": "bebas"
      },
      {
        "type": "font_picker",
        "id": "heading_font_library",
        "label": "t:settings_schema.typography.settings.heading_font_library.label",
        "default": "sans_serif_n7",
        "visible_if": "{{ settings.heading_font == 'library' }}"
      },
      {
        "type": "select",
        "id": "heading_case",
        "label": "t:settings_schema.typography.settings.heading_case.label",
        "options": [
          {
            "value": "none",
            "label": "t:settings_schema.typography.settings.case.options__1.label"
          },
          {
            "value": "uppercase",
            "label": "t:settings_schema.typography.settings.case.options__2.label"
          }
        ],
        "default": "uppercase"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "label": "t:settings_schema.typography.settings.heading_scale.label",
        "min": 80,
        "max": 130,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "range",
        "id": "heading_letter_spacing",
        "label": "t:settings_schema.typography.settings.heading_letter_spacing.label",
        "min": -6,
        "max": 6,
        "step": 1,
        "default": 1
      },
      {
        "type": "header",
        "content": "t:settings_schema.typography.settings.header__2.content"
      },
      {
        "type": "select",
        "id": "body_font",
        "label": "t:settings_schema.typography.settings.body_font.label",
        "options": [
          {
            "value": "inter",
            "label": "Inter"
          },
          {
            "value": "library",
            "label": "t:settings_schema.typography.settings.font_library_option"
          }
        ],
        "default": "inter"
      },
      {
        "type": "font_picker",
        "id": "body_font_library",
        "label": "t:settings_schema.typography.settings.body_font_library.label",
        "default": "sans_serif_n4",
        "visible_if": "{{ settings.body_font == 'library' }}"
      },
      {
        "type": "header",
        "content": "t:settings_schema.typography.settings.header__3.content"
      },
      {
        "type": "select",
        "id": "label_font",
        "label": "t:settings_schema.typography.settings.label_font.label",
        "info": "t:settings_schema.typography.settings.label_font.info",
        "options": [
          {
            "value": "mono",
            "label": "JetBrains Mono"
          },
          {
            "value": "body",
            "label": "t:settings_schema.typography.settings.label_font.options__2.label"
          }
        ],
        "default": "mono"
      },
      {
        "type": "select",
        "id": "label_case",
        "label": "t:settings_schema.typography.settings.label_case.label",
        "options": [
          {
            "value": "none",
            "label": "t:settings_schema.typography.settings.case.options__1.label"
          },
          {
            "value": "uppercase",
            "label": "t:settings_schema.typography.settings.case.options__2.label"
          }
        ],
        "default": "uppercase"
      }
    ]
