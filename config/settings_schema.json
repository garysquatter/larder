        "default": "street"
      },
      {
        "type": "paragraph",
        "content": "t:settings_schema.style.settings.paragraph.content"
      },
      {
        "type": "select",
        "id": "hero_layout",
        "label": "t:settings_schema.style.settings.hero_layout.label",
        "options": [
          {
            "value": "full",
            "label": "t:settings_schema.style.settings.hero_layout.options__1.label"
          },
          {
            "value": "split",
            "label": "t:settings_schema.style.settings.hero_layout.options__2.label"
          },
          {
