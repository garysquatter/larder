{%- layout none -%}
{%- assign gc_balance = gift_card.balance | money -%}
{%- assign gc_initial = gift_card.initial_value | money -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ 'gift_cards.issued.title' | t: value: gc_balance, shop: shop.name }}</title>
    {% render 'theme-styles' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  {%- capture body_hf -%}{% render 'style-value', key: 'heading_font' %}{%- endcapture -%}
  <body class="heading-font-{{ body_hf }} color-scheme-1">
    <main class="section text-center" style="--pt: .75; --pb: .75;">
      <div class="page-width stack" style="--gap: 20px; align-items: center; max-width: 560px;">
        <p class="h2">{{ shop.name }}</p>
        <h1 class="h3">{{ 'gift_cards.issued.title' | t: value: gc_initial, shop: shop.name }}</h1>
        <div class="card" style="padding: 32px; width: 100%;">
          <p class="h1" style="margin: 0;">{{ gift_card.balance | money }}</p>
          {%- if gift_card.expired -%}
            <p class="label">{{ 'gift_cards.issued.expired' | t }}</p>
          {%- elsif gift_card.expires_on -%}
            {%- assign gc_expiry = gift_card.expires_on | date: '%d %B %Y' -%}
            <p class="muted">{{ 'gift_cards.issued.expires_on' | t: expiry: gc_expiry }}</p>
          {%- endif -%}
          <p class="label" style="margin-top: 20px;">{{ 'gift_cards.issued.code' | t }}</p>
          <p style="font-size: 1.5rem; font-weight: 700; letter-spacing: .08em;">{{ gift_card.code | format_code }}</p>
          <div id="QrCode" data-identifier="{{ gift_card.qr_identifier }}" style="display: flex; justify-content: center;"></div>
        </div>
        <div class="form-row" style="justify-content: center;">
          <a class="btn" href="{{ shop.url }}">{{ 'gift_cards.issued.shop_link' | t }}</a>
          <button type="button" class="btn btn--secondary" onclick="window.print();">{{ 'gift_cards.issued.print' | t }}</button>
        </div>
        {%- if gift_card.pass_url -%}
          <a href="{{ gift_card.pass_url }}"><img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="Add to Apple Wallet" loading="lazy"></a>
        {%- endif -%}
      </div>
    </main>
    <script>
      window.addEventListener('load', function () {
        var el = document.getElementById('QrCode');
        if (el && window.QRCode) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
      });
    </script>
  </body>
</html>
