<section class="section text-center" style="--pt: 1; --pb: 1; min-height: 100vh; display: flex; align-items: center;">
  <div class="page-width stack" style="--gap: 20px; align-items: center; max-width: 560px;">
    <p class="h1">{{ shop.name }}</p>
    {%- assign opening_soon = 'general.password_page.opening_soon' | t -%}
    <p class="lede">{{ shop.password_message | default: opening_soon }}</p>
    {%- form 'storefront_password' -%}
      <div class="form-row" style="justify-content: center;">
        <label class="field" for="Password" style="text-align: left;">
          {{ 'general.password_page.login_form_password_label' | t }}
          <input type="password" name="password" id="Password" autocomplete="current-password" required>
        </label>
        <button type="submit" class="btn" style="min-height: 50px;">{{ 'general.password_page.login_password_button' | t }}</button>
      </div>
      {%- if form.errors -%}<p class="form-message" role="alert">{{ 'general.password_page.login_form_error' | t }}</p>{%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Password", "settings": [] }
{% endschema %}
