<section class="section" style="--pt: .5; --pb: .75;">
  <div class="page-width">
    <div class="section-head">
      <h1 class="h1">{{ 'customer.account.title' | t }}</h1>
      <a href="{{ routes.account_logout_url }}" class="link-underline">{{ 'customer.account.logout' | t }}</a>
    </div>
    <div class="account-grid">
      <div>
        <h2 class="h3" style="margin-bottom: 16px;">{{ 'customer.account.orders' | t }}</h2>
        {%- paginate customer.orders by 20 -%}
          {%- if customer.orders.size > 0 -%}
            <div class="table-wrap">
              <table class="table">
                <thead><tr><th scope="col">{{ 'customer.order.order' | t }}</th><th scope="col">{{ 'customer.order.date' | t }}</th><th scope="col">{{ 'customer.order.status' | t }}</th><th scope="col">{{ 'cart.total' | t }}</th></tr></thead>
                <tbody>
                  {%- for order in customer.orders -%}
                    <tr><td><a href="{{ order.customer_url }}">{{ order.name }}</a></td><td>{{ order.created_at | time_tag: format: 'date' }}</td><td>{{ order.fulfillment_status_label }}</td><td>{{ order.total_price | money_with_currency }}</td></tr>
                  {%- endfor -%}
                </tbody>
              </table>
            </div>
            {% render 'pagination', paginate: paginate %}
          {%- else -%}
            <p class="muted">{{ 'customer.account.no_orders' | t }}</p>
          {%- endif -%}
        {%- endpaginate -%}
      </div>
      <div class="card" style="padding: 24px;">
        <h2 class="h4" style="margin-bottom: 12px;">{{ 'customer.account.details' | t }}</h2>
        <p style="margin: 0;">{{ customer.name }}<br>{{ customer.email }}</p>
        {%- if customer.default_address -%}<p>{{ customer.default_address | format_address }}</p>{%- endif -%}
        <a href="{{ routes.account_addresses_url }}" class="link-underline">{{ 'customer.account.addresses' | t: count: customer.addresses_count }}</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{ "name": "Account", "settings": [] }
{% endschema %}
