<section class="section" style="--pt: .5; --pb: .75;">
  <div class="page-width narrow stack" style="--gap: 20px;">
    <h1 class="h1">{{ 'customer.reset.title' | t }}</h1>
    {%- form 'reset_customer_password' -%}
      <div class="stack" style="--gap: 14px;">
        {%- if form.errors -%}<div class="form-message" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <label class="field" for="ResetPassword">{{ 'customer.fields.password' | t }}<input type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password" required></label>
        <label class="field" for="ResetConfirm">{{ 'customer.fields.password_confirm' | t }}<input type="password" name="customer[password_confirmation]" id="ResetConfirm" autocomplete="new-password" required></label>
        <button type="submit" class="btn btn--full">{{ 'customer.reset.submit' | t }}</button>
      </div>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Reset password", "settings": [] }
{% endschema %}
