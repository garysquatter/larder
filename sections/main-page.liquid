<section class="section" style="--pt: 0.4; --pb: 0.6;">
  <div class="page-width"{% if section.settings.content_width == 'narrow' %} style="max-width: 820px;"{% endif %}>
    <h1 class="h1" style="margin-bottom: 32px;">{{ page.title | escape }}</h1>
    {%- if page.content != blank -%}
      <div class="rte"{% if section.settings.content_width == 'full' %} style="max-width: 820px;"{% endif %}>{{ page.content }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Page",
  "settings": [
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "info": "Use Full to align the title with full-width sections below, such as the contact form.",
      "options": [
        { "value": "narrow", "label": "Narrow (centred)" },
        { "value": "full", "label": "Full (aligned to page edge)" }
      ],
      "default": "narrow"
    }
  ]
}
{% endschema %}
