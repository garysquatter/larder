{%- paginate blog.articles by 12 -%}
<section class="section" style="--pt: 0.4; --pb: 0.6;">
  <div class="page-width">
    <h1 class="h1" style="margin-bottom: 36px;">{{ blog.title | escape }}</h1>
    <div class="grid" style="--min: 300px; row-gap: 40px;">
      {%- for article in blog.articles -%}
        {% render 'article-card', article: article %}
      {%- endfor -%}
    </div>
    {% render 'pagination', paginate: paginate %}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{ "name": "Blog posts", "settings": [] }
{% endschema %}
